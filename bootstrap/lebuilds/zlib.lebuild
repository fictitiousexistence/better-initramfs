#!/bin/sh
name='zlib'
version='1.3.1'
sources=( "http://www.zlib.net/${name}-${version}.tar.gz" )
homepage="http://www.zlib.net/"
license='ZLIB'

build_cmd="
    cd /source/${name}-${version} && \
    ./configure --prefix=/binit/prefix --static && \
    make -j ${cores_num:-1} && \
    make install"

fetch_source
install_source
build_source
