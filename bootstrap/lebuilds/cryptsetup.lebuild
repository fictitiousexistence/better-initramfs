#!/bin/bash
name='cryptsetup'
version='2.7.5'
sources=( "https://www.kernel.org/pub/linux/utils/cryptsetup/v2.7/cryptsetup-2.7.5.tar.xz" )
homepage='https://gitlab.com/cryptsetup/cryptsetup'
license='GPLv2'

build_cmd="
    export CFLAGS=\"\$CFLAGS -O3\" && \
    export CXXFLAGS=\"\$CXXFLAGS -O3\" && \
    cd /source/${name}-${version} && \
    ./configure --prefix=/binit/prefix \
    --disable-nls \
    --disable-asciidoc \
    --disable-hw-opal \
    --disable-integritysetup \
    --disable-luks2-reencryption \
    --disable-pwquality \
    --disable-ssh-token \
    --enable-static \
    --disable-shared \
    --disable-veritysetup \
    --with-crypto_backend=gcrypt \
    --enable-static-cryptsetup && \
    make -j ${cores_num:-1} && \
    make install
"

deploy="/binit/prefix/sbin/cryptsetup.static"

fetch_source
install_source
build_source

    #sed -i 's/tests\/Makefile tests\/fuzz\/Makefile//' configure && \
    #sed -i 's/#! \/bin\/sh/#! \/bin\/bash/' configure && \
