#!/bin/sh
name='lvm2'
version='2.03.22'
sources=( "https://sourceware.org/ftp/lvm2/.${PV}.tgz" )
sources=( "https://sourceware.org/ftp/${name}/releases/LVM2.${version}.tgz" )
homepage='https://sourceware.org/lvm2/'
license='GPLv2'

# The reason why CPPFLAGS is appended to CFLAGS is that lvm2 build system
# ignores CPPFLAGS resulting in being unable to find libaio.h.

build_cmd="
    export CFLAGS=\"\$CFLAGS \$CPPFLAGS\" && \
    cd /source/${name}-${version} && \
    ./configure --prefix=/binit/prefix --enable-static_link --disable-nls --without-systemd-run --disable-systemd-journal --disable-selinux --disable-dependency-tracking --disable-silent-rules --enable-dmfilemapd --disable-dmeventd --enable-fsadm --disable-readline --disable-lvmlockd-sanlock --disable-notify-dbus --disable-app-machineid --disable-valgrind-pool && \
    make -j ${cores_num:-1} all device-mapper && \
    make install
"

deploy="/binit/prefix/sbin/lvm"

fetch_source
install_source
build_source
