#!/bin/sh
name='mdadm'
version='4.4'
sources=( "https://git.kernel.org/pub/scm/utils/${name}/${name}.git/snapshot/${name}-${version}.tar.gz" )
homepage='http://neil.brown.name/blog/mdadm'
license='GPLv2'

build_cmd="
    cd /source/${name}-${version} && \
    make MAP_DIR='/dev/.mdadm'
    make CXFLAGS=-DNO_LIBUDEV DESTDIR=/binit/prefix install
"

deploy="/binit/prefix/sbin/mdadm"

fetch_source
install_source
build_source
