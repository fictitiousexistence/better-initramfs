#!/bin/sh
name='json-c'
version='json-c-0.18-20240915'
sources=( "https://github.com/json-c/json-c/archive/refs/tags/${version}.tar.gz" )
homepage='https://github.com/json-c/json-c/wiki'
license='MIT'

build_cmd="
    cd /source/${name}-${version} && \
    mkdir json-c-build && \
    cd json-c-build && \
    cmake ../ -DISABLE_STATIC_FPIC=ON -DBUILD_SHARED_LIBS=OFF -DBUILD_STATIC_LIBS=ON -DCMAKE_INSTALL_PREFIX=/binit/prefix -DCMAKE_BUILD_TYPE=release -DBUILD_APPS=OFF -DDISABLE_WERROR=ON  -DDISABLE_EXTRA_LIBS=ON && \
    make -j ${cores_num:-1} && \
    make install
"

fetch_source
install_source
build_source
