#!/bin/sh
name='vconfig'
version='1.9'
sources=( "https://codeberg.org/fictitiousexistence/better-initramfs-dist-files/raw/branch/main/vlan.${version}.tar.gz" )
homepage='http://www.candelatech.com/~greear/vlan.html'
license='GPL-2'

build_cmd="
    cd /source/${name}-${version} && \
    make purge && \
    make vconfig && \
    install vconfig -m 755 /binit/prefix/sbin/vconfig
"

deploy="/binit/prefix/sbin/vconfig"

fetch_source
install_source
build_source

