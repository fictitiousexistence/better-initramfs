#!/bin/sh
name='libgcrypt'
version='1.11.0'
sources=( "https://gnupg.org/ftp/gcrypt/${name}/${name}-${version}.tar.bz2" )
homepage='http://www.gnupg.org/'
license='LGPLv2.1'

build_cmd="
    export CFLAGS=\"\$CFLAGS -O0\" && \
    export CXXFLAGS=\"\$CXXFLAGS -O0\" && \
    cd /source/${name}-${version} && \
    ./configure \
    --prefix=/binit/prefix \
    --with-libgpg-error-prefix=/binit/prefix \
    --enable-static=yes \
    --disable-padlock-support \
    --disable-jent \
    --enable-shared=no \
    --enable-static=yes && \
    make -j ${cores_num:-1} && \
    make install
"

fetch_source
install_source
build_source
